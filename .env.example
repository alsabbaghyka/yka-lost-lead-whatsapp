# Copy to .env (never commit .env) or set these in the container / service environment.

# --- server ---
PORT=8080
# 127.0.0.1 behind a reverse proxy on the same host; 0.0.0.0 inside Docker
HOST=127.0.0.1
# the public https address Meta calls, without a trailing slash (shown on the Settings screen)
PUBLIC_URL=https://lostlead.example.internal
DB_PATH=./data/lost-lead.db
BACKUP_DIR=./backups
# 1 when served over https (it must be, in production): adds Secure to the session cookie
COOKIE_SECURE=1
SESSION_HOURS=12

# --- WhatsApp provider: mock (default, simulated), dry-run (records only), cloud (Meta) ---
WA_PROVIDER=mock
# Graph API version, checked against Meta's changelog on 23 Nov 2026 (latest: v27.0)
WA_GRAPH_VERSION=v27.0
# required when WA_PROVIDER=cloud — see docs/INTEGRATION.md
WA_ACCESS_TOKEN=
WA_PHONE_NUMBER_ID=
WA_WABA_ID=
WA_APP_SECRET=
WA_VERIFY_TOKEN=

# --- workers ---
WORKER_INTERVAL_MS=2000
SCHEDULER_INTERVAL_MS=60000

# --- mock provider only ---
# every Nth number (by its last two digits) behaves as "not on WhatsApp" (0 = none)
MOCK_FAIL_EVERY=0
# 0 = the Day 2/7/30 draft templates come back PENDING, to see the approval gate work
MOCK_APPROVE_DRAFTS=1
